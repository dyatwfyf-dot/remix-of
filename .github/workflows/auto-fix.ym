name: Auto-fix TypeScript & ESLint

on:
  push:
    branches: [ main ]
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  autofix:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18
          cache: "pnpm"

      - name: Enable corepack & install pnpm
        run: |
          corepack enable
          corepack prepare pnpm@latest --activate

      - name: Install dependencies
        run: pnpm install

      - name: Run TypeScript check (no emit)
        run: pnpm exec tsc --noEmit || true

      - name: Run ESLint autofix
        run: pnpm exec eslint . --ext .ts,.tsx --fix || true

      - name: Run Prettier
        run: pnpm exec prettier --write . || true

      - name: Commit & push fixes
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          if ! git diff --staged --quiet; then
            git commit -m "chore: apply automatic TypeScript/ESLint/Prettier fixes"
            git push origin HEAD:main
          else
            echo "No changes to commit"
          fi
